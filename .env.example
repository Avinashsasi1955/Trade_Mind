NIVESH_HOST=127.0.0.1
NIVESH_PORT=4173
NIVESH_ENV=development
NIVESH_SECRET=replace-with-a-long-random-production-secret
NIVESH_MODEL_ARTIFACT_KEY=replace-with-a-different-long-random-secret
NIVESH_REQUIRE_SIGNED_MODEL=1
NIVESH_BROKER_SESSION_KEY=replace-with-a-third-long-random-secret
NIVESH_TOKEN_TTL=86400
NIVESH_COOKIE_SECURE=0
NIVESH_DEMO_MODE=1
NIVESH_SIGNUP_ENABLED=1
NIVESH_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
NIVESH_ADMIN_EMAILS=arjun@example.com
NIVESH_COGNITO_AUTH_REQUIRED=0
NIVESH_TRUSTED_ALB_ARN=
NIVESH_COGNITO_LOGOUT_URL=
NIVESH_DATABASE=data/nivesh.db
# Optional OpenAI-compatible narrative model. The local structure engine works without these.
NIVESH_LLM_BASE_URL=
NIVESH_LLM_API_KEY=
NIVESH_LLM_MODEL=

# Provider routing: auto | local | nvidia | gemini | groq | ollama | anthropic | openai | compatible
NIVESH_MODEL_PROVIDER=auto

# Free-tier option: create a key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Free-tier option: Groq Cloud (ultra-fast Llama 3 at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Fully local/no-key option: run Ollama separately and pull the selected model.
OLLAMA_ENABLED=0
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gpt-oss:20b

# Optional paid providers; never commit real keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# NVIDIA-hosted NIM is OpenAI-compatible. Catalog access and quotas depend on
# your NVIDIA account; do not assume unlimited free production use.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5

# AI gateway safety controls
AI_GATEWAY_RATE_LIMIT=10
AI_GATEWAY_CACHE_SECONDS=600
AI_GATEWAY_CIRCUIT_SECONDS=120
NIVESH_AI_RAG_ENABLED=1
NIVESH_AI_RAG_TOP_K=6
NIVESH_AI_RAG_MULTI_MODEL_ENABLED=1
NIVESH_AI_RAG_MAX_MODELS=3

# Zerodha Kite read-only market data. Access tokens are session credentials;
# keep them in your environment manager, never in source control.
NIVESH_MARKET_DATA_PROVIDER=zerodha
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=http://127.0.0.1:4173/api/broker/zerodha/callback
# Live-paper stream capacity and recovery. Full depth is reserved for priority
# instruments; the total is bounded by Kite's three-connection allowance.
NIVESH_KITE_FULL_MODE_LIMIT=2500
NIVESH_KITE_TOTAL_TOKEN_LIMIT=9000
NIVESH_GAP_BACKFILL_LIMIT=20

# Upstox market data and execution tokens.
# UPSTOX_ACCESS_TOKEN / UPSTOX_ANALYTICS_TOKEN: read-only market data feed.
# UPSTOX_ORDER_ACCESS_TOKEN: daily interactive write token for order placement/modification.
UPSTOX_ACCESS_TOKEN=
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_ORDER_ACCESS_TOKEN=
UPSTOX_INSTRUMENTS_URL=https://assets.upstox.com/market-quote/instruments/exchange/complete.json.gz
NIVESH_UPSTOX_FULL_MODE_LIMIT=500
NIVESH_UPSTOX_TOTAL_KEY_LIMIT=2000
# Read-only Upstox option-chain REST OI snapshots. These improve option paper
# trade quality gates by adding OI plus bid/ask spread evidence.
NIVESH_UPSTOX_OPTION_CHAIN_OI_ENABLED=1
NIVESH_UPSTOX_OPTION_CHAIN_LIMIT=8
NIVESH_UPSTOX_OPTION_CHAIN_UNDERLYINGS=NIFTY 50,BANKNIFTY,SENSEX,RELIANCE,HDFCBANK,ICICIBANK,INFY,TCS
NIVESH_UPSTOX_OPTION_CHAIN_SLEEP_SECONDS=0.35

# Requires explicit operator action after every other safety gate is validated.
NIVESH_LIVE_TRADING_ENABLED=0
# Independent model-promotion fuse. Both flags must pass before submission is possible.
LIVE_ELIGIBLE=FALSE
NIVESH_MARKET_HISTORY=data/market_history.db
NIVESH_ML_MAX_SYMBOLS_PER_SESSION=500
NIVESH_ML_MIN_ADTV=10000000
NIVESH_ML_MIN_COVERAGE_PCT=95
NIVESH_ML_MIN_DAILY_BARS=250
NIVESH_ML_TRAINING_EXCHANGES=NSE

# Auditable ML research warehouse and paper-only retraining schedule.
NIVESH_ML_RESEARCH=data/ml_research.db
NIVESH_ML_MIN_TRAIN_SAMPLES=120
NIVESH_ML_AUTO_RETRAIN=1
NIVESH_ML_RETRAIN_DAYS=7
NIVESH_LIVE_INFERENCE_SYMBOL_LIMIT=500
NIVESH_PAPER_NOTIONAL=10000
NIVESH_PAPER_EXIT_MINUTES=30
NIVESH_PAPER_STOP_LOSS_PCT=0.006
NIVESH_PAPER_TAKE_PROFIT_PCT=0.012
NIVESH_PAPER_OPTION_STOP_LOSS_PCT=0.06
NIVESH_PAPER_OPTION_TAKE_PROFIT_PCT=0.14
NIVESH_SHADOW_TRAILING_STOP_ENABLED=1
NIVESH_SHADOW_TRAILING_TRIGGER_PCT=0.14
NIVESH_SHADOW_TRAILING_GIVEBACK_PCT=0.07
NIVESH_SHADOW_BREAKEVEN_TRIGGER_PCT=0.10
NIVESH_SHADOW_ACTIVE_TRADE_MANAGER_ENABLED=0
NIVESH_SHADOW_MANAGER_BREAKEVEN_BUFFER_PCT=0.01
NIVESH_SHADOW_MANAGER_ATR_STOP_MULTIPLE=1.6
NIVESH_SHADOW_MANAGER_PROFIT_LOCK_TRIGGER_PCT=0.004
NIVESH_SHADOW_MANAGER_PROFIT_LOCK_RUPEES=75
NIVESH_SHADOW_MANAGER_MIN_LOCKED_PROFIT_RUPEES=40
NIVESH_SHADOW_OPTION_MANAGER_PROFIT_LOCK_TRIGGER_PCT=0.018
NIVESH_SHADOW_OPTION_MANAGER_PROFIT_LOCK_RUPEES=250
NIVESH_SHADOW_OPTION_MANAGER_MIN_LOCKED_PROFIT_RUPEES=150
NIVESH_SHADOW_OPTION_MANAGER_GIVEBACK_PCT=0.20
NIVESH_SHADOW_MANAGER_TARGET_EXTEND_TRIGGER_PCT=0.16
NIVESH_SHADOW_MANAGER_EXTENDED_RR=2.2
NIVESH_SHADOW_MANAGER_MIN_STOP_GAP_PCT=0.004
NIVESH_SHADOW_PROFIT_CAPTURE_ENABLED=1
NIVESH_SHADOW_PROFIT_CAPTURE_RUPEES=100
NIVESH_SHADOW_OPTION_PROFIT_CAPTURE_RUPEES=250
NIVESH_SHADOW_PROFIT_CAPTURE_PCT=0.004
NIVESH_SHADOW_OPTION_PROFIT_CAPTURE_PCT=0.018
NIVESH_SHADOW_MAX_DAILY_LOSS=1200
NIVESH_SHADOW_HARD_KILL_DAILY_LOSS=10000
NIVESH_SHADOW_DAILY_TRADE_TARGET=40
NIVESH_SHADOW_MAX_DAILY_TRADES=40
NIVESH_SHADOW_MAX_DAILY_LOSSES=18
NIVESH_SHADOW_MAX_CONSECUTIVE_LOSSES=3
NIVESH_SHADOW_MAX_LOSSES_PER_UNDERLYING=1
NIVESH_SHADOW_MAX_OPEN_PER_SECTOR=2
NIVESH_SHADOW_MAX_NEW_PER_SECTOR=1
NIVESH_SHADOW_ENTRY_CUTOFF_IST=15:05
NIVESH_SHADOW_FORCE_FLAT_IST=15:15
NIVESH_SHADOW_REENTRY_COOLDOWN_MINUTES=30
NIVESH_SHADOW_MIN_OPTION_PRICE=20
NIVESH_SHADOW_MAX_OPTION_PRICE=450
NIVESH_SHADOW_MIN_OPTION_VOLUME=1
NIVESH_SHADOW_MIN_OPTION_OI=500
NIVESH_SHADOW_MAX_OPTION_DAYS_TO_EXPIRY=45
NIVESH_SHADOW_OPTION_COVERAGE_SOURCES=zerodha_kite,kite_gap_backfill,upstox_v3,upstox_rest_intraday,upstox_rest_5m
NIVESH_SHADOW_MIN_OPTION_RECENT_1M_COVERAGE_PCT=70
NIVESH_SHADOW_OPTION_RECENT_COVERAGE_MINUTES=30
NIVESH_SHADOW_MIN_OPTION_SESSION_1M_COVERAGE_PCT=50
NIVESH_SHADOW_OPTION_STOP_NOISE_ATR_MULTIPLE=1.15
NIVESH_SHADOW_MAX_OPTION_LOSS_RUPEES=375
NIVESH_SHADOW_OPTION_STOP_TO_CAPTURE_MAX_RATIO=1.50
NIVESH_SHADOW_OPTION_MAX_FEE_TO_REWARD_RATIO=0.25
NIVESH_SHADOW_TOP10_SELECTOR_ENABLED=1
NIVESH_SHADOW_MIN_ENTRY_QUALITY=74
NIVESH_SHADOW_MIN_OPTION_ENTRY_QUALITY=68
NIVESH_SHADOW_MIN_OPTION_GRADE=B
NIVESH_SHADOW_OPTION_GRADE_A_SCORE=78
NIVESH_SHADOW_OPTION_GRADE_B_SCORE=68
NIVESH_SHADOW_MIN_PROFESSIONAL_RR=1.90
NIVESH_SHADOW_MIN_EXPECTED_NET_EDGE_BPS=35
NIVESH_SHADOW_REQUIRE_DEPTH_FOR_ENTRIES=1
NIVESH_SHADOW_MAX_SAME_SIDE_OPEN=5
NIVESH_SHADOW_MAX_NEW_SAME_SIDE=3
NIVESH_SHADOW_MAX_SPREAD_BPS=60
NIVESH_SHADOW_MAX_OPTION_SPREAD_BPS=120
NIVESH_SHADOW_MAX_INTRADAY_ATR_PCT=0.035
# Keep the news/sentiment gate explicit OFF until a real licensed news feed is connected.
NIVESH_SHADOW_SENTIMENT_GATE_ENABLED=0
NIVESH_SHADOW_REQUIRE_VERIFIED_SENTIMENT=0
NIVESH_SHADOW_SENTIMENT_MIN_CONFIDENCE=60
NIVESH_SHADOW_SENTIMENT_MAX_AGE_HOURS=24
NIVESH_ML_FEEDBACK_MIN_QUALITY=68
NIVESH_SHADOW_ADAPTIVE_LEARNING_ENABLED=1
NIVESH_SHADOW_ADAPTIVE_MIN_SAMPLES=3
NIVESH_SHADOW_ADAPTIVE_MAX_LOSS_RATE=0.62
NIVESH_SHADOW_ADAPTIVE_MIN_AVG_REWARD=-1.0
# Live 1-second candles are WebSocket-derived only. They are used as a
# senior-layer entry-timing guard, not as fabricated historical training data.
NIVESH_SHADOW_1S_MICROSTRUCTURE_GATE_ENABLED=1
NIVESH_SHADOW_1S_LOOKBACK_SECONDS=20
NIVESH_SHADOW_1S_MIN_BARS=8
NIVESH_SHADOW_1S_MAX_ADVERSE_BPS=8
NIVESH_SHADOW_REQUIRE_1S_FOR_ENTRIES=1
NIVESH_SHADOW_MAX_SIGNAL_AGE_MINUTES=6
# Storage guard: 1s candles are heavy. Set 0 to keep all.
NIVESH_1S_RETENTION_DAYS=30
NIVESH_SHADOW_PROBE_TRADES_ENABLED=0
NIVESH_SHADOW_PROBE_TRADE_LIMIT=0
NIVESH_SHADOW_MAX_NEW_TRADES_PER_CYCLE=4
NIVESH_MAX_OPEN_SHADOW_TRADES=10
NIVESH_SHADOW_MAX_TRADES_PER_UNDERLYING=1
NIVESH_SHADOW_MAX_INDEX_LEARNING_TRADES=0
NIVESH_SHADOW_OPTION_PAPER_ENABLED=1
NIVESH_SHADOW_LEARNING_MODE_ENABLED=0
# Paper entries use only true live-feed bars, not REST repair candles.
NIVESH_SHADOW_TRADE_BAR_SOURCES=zerodha_kite,upstox_v3
# Keep disabled for professional mode: bearish cash-equity signals must route to
# valid derivatives, otherwise the paper risk engine rejects the trade.
NIVESH_SHADOW_INTRADAY_SHORT_FALLBACK=0
# Never enable this for formal validation: v2.5 is trained on daily features.
NIVESH_ALLOW_PROVISIONAL_INTRADAY_MODEL=0
# Read-only reliability automation. Auto-repair fills missing completed 1m/5m
# candles from Upstox REST when WebSocket/network gaps happen. It never places
# orders and uses INSERT ... ON CONFLICT DO NOTHING.
NIVESH_AUTO_GAP_REPAIR_ENABLED=1
NIVESH_AUTO_GAP_REPAIR_LIMIT=100
NIVESH_EOD_REPAIR_BEFORE_REPORT=1
NIVESH_EOD_GAP_REPAIR_LIMIT=200
# Minimum evidence required before one forward session receives credit.
NIVESH_MIN_1M_BUCKETS=350
NIVESH_MIN_5M_BUCKETS=70
NIVESH_MIN_LIVE_INSTRUMENTS=50
NIVESH_MIN_OI_OBSERVATIONS=50
NIVESH_MIN_SESSION_PREDICTIONS=10
NIVESH_MIN_SESSION_PAPER_TRADES=1
NIVESH_BACKUP_DIR=data/backups
NIVESH_BACKUP_RETENTION_DAYS=14

# Licensed news feed. The key stays server-side and is never sent to the browser.
# For Finnhub, use https://finnhub.io/api/v1 and set FINNHUB_API_KEY or NIVESH_NEWS_API_KEY.
NIVESH_NEWS_PROVIDER=finnhub
NIVESH_NEWS_API_BASE_URL=https://finnhub.io/api/v1
NIVESH_NEWS_API_KEY=
NIVESH_NEWS_API_KEY_HEADER=
NIVESH_NEWS_CACHE_SECONDS=900
NIVESH_NEWS_MAX_ARTICLES=30
FINNHUB_API_KEY=
FINNHUB_NEWS_LOOKBACK_DAYS=7
FINNHUB_NEWS_CATEGORY=general
FINNHUB_WEBHOOK_URL=
FINNHUB_WEBHOOK_SECRET=

# Optional FinBERT/Hugging Face-compatible inference endpoint.
NIVESH_SENTIMENT_MODEL_URL=
NIVESH_SENTIMENT_MODEL_API_KEY=
NIVESH_SENTIMENT_MODEL_NAME=ProsusAI/finbert
NIVESH_SENTIMENT_MODEL_MAX_ARTICLES=6

# Version 3 infrastructure. Keep disabled until PostgreSQL migration and shadow acceptance are complete.
# Leave blank for the portable SQLite preview. Production/Docker supplies this
# through its environment or secret manager.
DATABASE_URL=
# DATABASE_URL=postgresql+psycopg2://nivesh:replace-me@postgres:5432/nivesh
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=12
POSTGRES_PASSWORD=replace-with-a-random-secret
REDIS_PASSWORD=replace-with-a-random-secret
REDIS_URL=
# REDIS_URL=redis://:replace-me@redis:6379/0
NIVESH_FINBERT_MODEL=ProsusAI/finbert
NIVESH_FINBERT_REVISION=2280066c35926ed43b2719a19c9dc5883146e4b1
# Leave NIVESH_NEWS_SYMBOLS blank to use the built-in liquid NSE sentiment-intelligence universe.
FINNHUB_NEWS_TIMEOUT_SECONDS=8
NIVESH_NEWS_SCAN_SYMBOL_LIMIT=50
NIVESH_NEWS_SYMBOLS=
NIVESH_SHADOW_SENTIMENT_GATE_ENABLED=0
NIVESH_SHADOW_REQUIRE_VERIFIED_SENTIMENT=0
NIVESH_SHADOW_SENTIMENT_MIN_CONFIDENCE=60
NIVESH_SHADOW_SENTIMENT_MAX_AGE_HOURS=24
FINBERT_CPU_THREADS=2
FINBERT_USE_GPU=0

# Structured logs and production paging. Point the webhook to your incident platform.
NIVESH_LOG_LEVEL=INFO
NIVESH_ALERT_WEBHOOK_URL=
NIVESH_ALERT_COOLDOWN_SECONDS=900
