# Copy to backend.hcl only after creating a dedicated, versioned, access-logged
# state bucket and KMS key outside this stack. Never commit backend.hcl.
bucket       = "replace-with-dedicated-private-state-bucket"
key          = "nivesh/production/terraform.tfstate"
region       = "ap-south-1"
encrypt      = true
kms_key_id   = "replace-with-state-kms-key-arn"
use_lockfile = true
